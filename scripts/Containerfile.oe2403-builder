# openEuler 24.03 LTS ppc64le OpenHPC Builder Container
#
# Provides a complete build environment for compiling all 68 OpenHPC 4.x
# components on openEuler 24.03 ppc64le. Used by the VersatusHPC build pipeline.
#
# openEuler 24.03 ppc64le only ships the OS repo (~2362 packages).
# The everything/EPOL/update repos are NOT available for ppc64le.
# SP1 and SP2 dropped ppc64le entirely.
#
# Build:  podman build -t oe2403-ohpc-builder -f scripts/Containerfile.oe2403-builder .
# Run:    podman run -d --name oe-builder --privileged \
#           -v /home/builder/versatushpc-4.x:/ohpc:Z \
#           oe2403-ohpc-builder sleep infinity

FROM docker.io/openeuler/openeuler:24.03-lts

# ── Use Huawei Cloud mirror (faster outside China) ──────────────────
RUN sed -i "s@repo.openeuler.org@repo.huaweicloud.com/openeuler@g" /etc/yum.repos.d/openEuler.repo

# ── System build tools ──────────────────────────────────────────────
RUN dnf -y install \
        rpm-build \
        gcc gcc-c++ gcc-gfortran \
        make autoconf automake libtool cmake \
        bison flex patch file hostname \
        git wget curl \
        python3 python3-devel python3-setuptools \
        lua lua-devel \
        perl perl-devel perl-Encode-devel \
        tcl tcl-devel tk-devel \
        bzip2 bzip2-devel xz xz-devel zstd \
        openssl-devel ncurses-devel readline-devel \
        libxml2-devel libcurl-devel expat-devel \
        pam-devel numactl-devel libevent-devel \
        rdma-core-devel \
        binutils-devel \
        json-c json-glib jsoncpp \
        libicu-devel pcre2-devel zlib-devel \
        libpng-devel fontconfig-devel freetype-devel \
        libX11-devel libXt-devel libXft-devel \
        libXext-devel libXrender-devel libXau-devel \
        libxcb-devel libICE-devel libSM-devel \
        cairo cairo-gobject glib2-devel \
        libffi-devel libstdc++-devel libquadmath-devel \
        libnl3-devel \
        libpq-devel mariadb-connector-c-devel \
        check-devel systemtap-sdt-devel \
        gettext-devel \
    && dnf clean all

# ── Rebuild missing -devel packages from SRPMs ─────────────────────
# openEuler 24.03 ppc64le is missing these in the OS repo.
# SRPMs are fetched from the openEuler source repo and rebuilt.
ARG OE_MIRROR=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS
ARG OE_SRC=${OE_MIRROR}/source/Packages

RUN cd /tmp && \
    wget -q ${OE_SRC}/libfabric-1.20.0-1.src.rpm && \
    rpmbuild --rebuild --nodeps libfabric-1.20.0-1.src.rpm && \
    dnf -y install /root/rpmbuild/RPMS/ppc64le/libfabric-*.rpm && \
    rm -f libfabric-1.20.0-1.src.rpm

RUN cd /tmp && \
    wget -q ${OE_SRC}/freeipmi-1.6.14-1.src.rpm && \
    rpmbuild --rebuild --nodeps freeipmi-1.6.14-1.src.rpm && \
    dnf -y install /root/rpmbuild/RPMS/ppc64le/freeipmi-*.rpm && \
    rm -f freeipmi-1.6.14-1.src.rpm

RUN cd /tmp && \
    wget -q ${OE_SRC}/libedit-3.1-1.src.rpm && \
    rpmbuild --rebuild --nodeps libedit-3.1-1.src.rpm && \
    dnf -y install /root/rpmbuild/RPMS/ppc64le/libedit-*.rpm && \
    rm -f libedit-3.1-1.src.rpm

RUN cd /tmp && \
    wget -q ${OE_SRC}/yaml-cpp-0.7.0-1.src.rpm && \
    rpmbuild --rebuild --nodeps yaml-cpp-0.7.0-1.src.rpm && \
    dnf -y install /root/rpmbuild/RPMS/ppc64le/yaml-cpp-*.rpm && \
    rm -f yaml-cpp-0.7.0-1.src.rpm

RUN cd /tmp && \
    wget -q ${OE_SRC}/libyaml-0.2.5-6.oe2403.src.rpm && \
    rpmbuild --rebuild --nodeps libyaml-0.2.5-6.oe2403.src.rpm && \
    dnf -y install /root/rpmbuild/RPMS/ppc64le/libyaml-[0-9]*.rpm /root/rpmbuild/RPMS/ppc64le/libyaml-devel-*.rpm && \
    rm -f libyaml-0.2.5-6.oe2403.src.rpm

# Clean up SRPM rebuild artifacts
RUN rm -rf /root/rpmbuild/{BUILD,BUILDROOT,SOURCES,SPECS,SRPMS}/*

# ── VersatusHPC ppc64le OpenHPC repository ──────────────────────────
# Upstream OpenHPC repos do not provide ppc64le packages — use VersatusHPC
COPY scripts/repo-files/openEuler_24.03/versatushpc-openhpc.repo /etc/yum.repos.d/
RUN dnf -y install \
        ohpc-filesystem ohpc-buildroot lmod-ohpc \
        gnu15-compilers-ohpc \
        cmake-ohpc hwloc-ohpc \
        ucx-ohpc ucx-ib-ohpc ucx-rdmacm-ohpc ucx-cma-ohpc \
        pmix-ohpc papi-ohpc valgrind-ohpc \
        openmpi5-gnu15-ohpc mpich-ofi-gnu15-ohpc \
        openblas-gnu15-ohpc gsl-gnu15-ohpc \
        metis-gnu15-ohpc superlu-gnu15-ohpc gotcha-gnu15-ohpc \
        opari2-gnu15-ohpc cubelib-gnu15-ohpc cubew-gnu15-ohpc \
        R-gnu15-ohpc plasma-gnu15-ohpc \
        boost-gnu15-openmpi5-ohpc fftw-gnu15-openmpi5-ohpc \
        scalapack-gnu15-openmpi5-ohpc hypre-gnu15-openmpi5-ohpc \
        hdf5-gnu15-ohpc phdf5-gnu15-openmpi5-ohpc \
        netcdf-gnu15-openmpi5-ohpc netcdf-fortran-gnu15-openmpi5-ohpc \
        netcdf-cxx-gnu15-openmpi5-ohpc \
        pnetcdf-gnu15-openmpi5-ohpc ptscotch-gnu15-openmpi5-ohpc \
        sionlib-gnu15-openmpi5-ohpc mumps-gnu15-openmpi5-ohpc \
        superlu_dist-gnu15-openmpi5-ohpc otf2-gnu15-openmpi5-ohpc \
        petsc-gnu15-openmpi5-ohpc slepc-gnu15-openmpi5-ohpc \
        scorep-gnu15-openmpi5-ohpc scalasca-gnu15-openmpi5-ohpc \
        pdtoolkit-gnu15-ohpc \
        python3-Cython-ohpc python3-numpy-gnu15-ohpc \
        python3-mpi4py-gnu15-openmpi5-ohpc \
        slurm-ohpc slurm-devel-ohpc slurm-contribs-ohpc \
        munge-ohpc munge-devel-ohpc munge-libs-ohpc \
        genders-ohpc genders-compat-ohpc \
        trilinos-gnu15-openmpi5-ohpc \
        mfem-gnu15-openmpi5-ohpc \
        extrae-gnu15-openmpi5-ohpc dimemas-gnu15-openmpi5-ohpc \
        imb-gnu15-openmpi5-ohpc omb-gnu15-openmpi5-ohpc \
    && dnf clean all

# ── rpmbuild environment ────────────────────────────────────────────
COPY scripts/rpm-macros /root/.rpmmacros
RUN rm -rf /root/rpmbuild && \
    mkdir -p /root/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
COPY components/OHPC_macros /root/rpmbuild/SOURCES/

CMD ["sleep", "infinity"]

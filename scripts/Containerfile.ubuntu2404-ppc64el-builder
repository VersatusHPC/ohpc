# Ubuntu 24.04 ppc64el OpenHPC Builder Container
#
# Built natively on POWER hosts. This image provides the common Debian
# packaging toolchain; per-package OpenHPC dependencies are installed from the
# local APT repository generated by scripts/build-ubuntu-ppc64el.sh.

FROM docker.io/library/ubuntu:24.04

ARG UBUNTU_MIRROR=""
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN set -eux; \
    if [ -n "${UBUNTU_MIRROR}" ]; then \
        sed -i "s|http://ports.ubuntu.com/ubuntu-ports|${UBUNTU_MIRROR}|g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        apt-utils \
        autoconf \
        automake \
        bc \
        bison \
        build-essential \
        ca-certificates \
        chrpath \
        cmake \
        curl \
        debhelper \
        devscripts \
        dh-python \
        dpkg-dev \
        equivs \
        fakeroot \
        file \
        flex \
        gfortran \
        git \
        gnupg \
        help2man \
        less \
        libtool \
        locales \
        lsb-release \
        m4 \
        make \
        ninja-build \
        patch \
        patchelf \
        pkg-config \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-venv \
        python3-wheel \
        rsync \
        sudo \
        tar \
        texinfo \
        unzip \
        wget \
        xz-utils \
        zstd; \
    locale-gen C.UTF-8; \
    rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR /build

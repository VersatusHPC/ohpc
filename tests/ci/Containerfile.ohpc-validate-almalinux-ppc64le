FROM docker.io/library/almalinux:10

# Native POWER build container for EL10 ppc64le validation. Build this image on
# a ppc64le host; it is intentionally independent of site-specific package mirrors.

RUN test "$(uname -m)" = "ppc64le"

RUN dnf -y install epel-release dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y update && \
    dnf -y install \
        rpm-build createrepo_c dnf-plugins-core \
        gcc gcc-c++ gcc-gfortran make autoconf automake libtool cmake \
        bison flex patch file which hostname git wget curl jq \
        python3 python3-devel python3-setuptools python3-pip \
        lua lua-devel perl perl-devel perl-Encode-devel \
        tcl tcl-devel tk tk-devel \
        bzip2 bzip2-devel xz xz-devel zstd libzstd-devel zlib-devel \
        texinfo texlive-latex \
        openssl-devel ncurses-devel readline-devel \
        libxml2-devel libcurl-devel expat-devel \
        pam-devel numactl-devel libevent-devel \
        rdma-core-devel libfabric-devel opensm-devel \
        binutils-devel elfutils-devel elfutils-libelf-devel \
        hwloc-devel json-c-devel jsoncpp-devel \
        freeipmi-devel libedit-devel yaml-cpp-devel \
        libicu-devel pcre2-devel zlib-ng-compat-devel \
        libjpeg-turbo-devel libpng-devel libtiff-devel libwebp-devel \
        libX11-devel libXt-devel libXmu-devel libXft-devel \
        libXext-devel libXrender-devel libXi-devel libXrandr-devel \
        libXinerama-devel libXcomposite-devel libXcursor-devel \
        libXdamage-devel libXfixes-devel libXtst-devel libXau-devel \
        libxcb-devel motif-devel \
        cairo-devel pango-devel gdk-pixbuf2-devel gtk3-devel \
        fontconfig-devel freetype-devel harfbuzz-devel \
        glib2-devel dbus-devel libepoxy-devel \
        libffi-devel libstdc++-devel libquadmath-devel \
        libnl3-devel libpciaccess-devel \
        libpq-devel mariadb-connector-c-devel sqlite-devel \
        libjwt-devel libical-devel \
        check-devel valgrind-devel systemtap-sdt-devel \
        ccache bats shellcheck \
    && dnf clean all

RUN useradd -m ohpc || true && \
    mkdir -p /home/ohpc/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS} && \
    chown -R ohpc:ohpc /home/ohpc/rpmbuild

COPY components/OHPC_macros /home/ohpc/rpmbuild/SOURCES/OHPC_macros

USER ohpc
WORKDIR /workspace

CMD ["/bin/bash"]

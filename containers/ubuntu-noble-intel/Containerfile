FROM localhost/ohpc-build-ubuntu:noble

# Add Intel oneAPI repository
RUN wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB | \
    gpg --dearmor -o /usr/share/keyrings/intel-oneapi.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/intel-oneapi.gpg] https://apt.repos.intel.com/oneapi all main" \
    > /etc/apt/sources.list.d/intel-oneapi.list && \
    apt-get update -qq

# Install Intel oneAPI compilers + MPI + MKL
RUN apt-get install -y --no-install-recommends \
    intel-oneapi-compiler-dpcpp-cpp \
    intel-oneapi-compiler-fortran \
    intel-oneapi-mkl-devel \
    intel-oneapi-mpi-devel && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create Intel compiler + MPI modulefiles for OHPC
RUN mkdir -p /opt/ohpc/pub/moduledeps/gnu15/impi && \
    echo '#%Module1.0' > /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'prepend-path PATH /opt/intel/oneapi/mpi/latest/bin' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'prepend-path LD_LIBRARY_PATH /opt/intel/oneapi/mpi/latest/lib' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'setenv MPI_DIR /opt/intel/oneapi/mpi/latest' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'prepend-path MODULEPATH /opt/ohpc/pub/moduledeps/gnu15-impi' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'prepend-path PKG_CONFIG_PATH /opt/intel/oneapi/mpi/latest/lib/pkgconfig' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17 && \
    echo 'family "MPI"' >> /opt/ohpc/pub/moduledeps/gnu15/impi/2021.17

# Create Intel compiler modulefile
RUN mkdir -p /opt/ohpc/pub/modulefiles/intel && \
    echo '#%Module1.0' > /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'set intel_root /opt/intel/oneapi' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'prepend-path PATH $intel_root/compiler/latest/bin' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'prepend-path LD_LIBRARY_PATH $intel_root/compiler/latest/lib' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'prepend-path LD_LIBRARY_PATH $intel_root/mkl/latest/lib' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'setenv MKLROOT $intel_root/mkl/latest' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'setenv CC icx' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'setenv CXX icpx' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'setenv FC ifx' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'setenv F77 ifx' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'prepend-path MODULEPATH /opt/ohpc/pub/moduledeps/intel' >> /opt/ohpc/pub/modulefiles/intel/2025.0 && \
    echo 'family "compiler"' >> /opt/ohpc/pub/modulefiles/intel/2025.0

#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=-all
export CFLAGS =
export CXXFLAGS =
export LDFLAGS =

PNAME        := hpc-workspace
VERSION      := 1.5.0
INSTALL_PATH := /opt/ohpc/admin/$(PNAME)/$(VERSION)
SRCDIR       := $(CURDIR)/$(PNAME)-$(VERSION)
PKG          := $(CURDIR)/debian/$(PNAME)-ohpc
OHPC_MODULES := /opt/ohpc/pub/modulefiles

%:
	dh $@

override_dh_auto_configure:
	test -s SOURCES/$(PNAME)-$(VERSION).tar.gz || \
		wget -q -O SOURCES/$(PNAME)-$(VERSION).tar.gz \
			https://github.com/holgerBerber/hpc-workspace/archive/refs/tags/$(VERSION).tar.gz
	rm -rf $(SRCDIR)
	tar --no-same-owner -xf SOURCES/$(PNAME)-$(VERSION).tar.gz

override_dh_auto_build:
	cd $(SRCDIR) && cmake -S . -B build \
		-DCMAKE_INSTALL_PREFIX=$(INSTALL_PATH) \
		-DCMAKE_BUILD_TYPE=Release
	cd $(SRCDIR) && cmake --build build -j$$(nproc)

override_dh_auto_install:
	cd $(SRCDIR) && DESTDIR=$(PKG) cmake --install build
	mkdir -p $(PKG)$(OHPC_MODULES)/$(PNAME)
	install -m 644 debian/modulefile $(PKG)$(OHPC_MODULES)/$(PNAME)/$(VERSION)

override_dh_auto_clean:
	rm -rf $(SRCDIR)

override_dh_usrlocal:

override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym || true

override_dh_auto_test:

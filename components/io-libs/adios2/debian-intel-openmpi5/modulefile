#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the ADIOS2 library built with the intel compiler"
puts stderr "toolchain and the openmpi5 MPI stack."
puts stderr "\nVersion 2.12.0\n"

}
module-whatis "Name: ADIOS2 built with intel compiler and openmpi5 MPI"
module-whatis "Version: 2.12.0"
module-whatis "Category: runtime library"
module-whatis "Description: The Adaptable IO System v2 (ADIOS2)"
module-whatis "https://adios2.readthedocs.io/en/latest/index.html"

set             version             2.12.0

depends-on phdf5
depends-on numpy
depends-on mpi4py

prepend-path    PATH                /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/bin
prepend-path    INCLUDE             /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/include
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/lib64

setenv          ADIOS2_DIR          /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0
setenv          ADIOS2_BIN          /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/bin
setenv          ADIOS2_LIB          /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/lib64
setenv          ADIOS2_INC          /opt/ohpc/pub/libs/intel/openmpi5/adios2/2.12.0/include

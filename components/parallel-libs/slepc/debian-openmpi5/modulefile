#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the SLEPc library built with the gnu15 compiler"
puts stderr "toolchain and the openmpi5 MPI stack."
puts stderr "\nVersion 3.25.0\n"

}
module-whatis "Name: slepc built with gnu15 compiler and openmpi5 MPI"
module-whatis "Version: 3.25.0"
module-whatis "Category: runtime library"
module-whatis "Description: Scalable Library for Eigenvalue Problem Computations"
module-whatis "URL http://slepc.upv.es"

set     version             3.25.0

depends-on petsc

prepend-path    INCLUDE             /opt/ohpc/pub/libs/gnu15/openmpi5/slepc/3.25.0/include
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/gnu15/openmpi5/slepc/3.25.0/lib

setenv          SLEPC_DIR           /opt/ohpc/pub/libs/gnu15/openmpi5/slepc/3.25.0
setenv          SLEPC_LIB           /opt/ohpc/pub/libs/gnu15/openmpi5/slepc/3.25.0/lib
setenv          SLEPC_INC           /opt/ohpc/pub/libs/gnu15/openmpi5/slepc/3.25.0/include
setenv          SLEPC_ARCH          ""

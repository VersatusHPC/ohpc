#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the PETSc library built with the gnu15 compiler"
puts stderr "toolchain and the mpich MPI stack."
puts stderr "\nVersion 3.25.0\n"

}
module-whatis "Name: petsc built with gnu15 compiler and mpich MPI"
module-whatis "Version: 3.25.0"
module-whatis "Category: runtime library"
module-whatis "Description: Portable Extensible Toolkit for Scientific Computation"
module-whatis "http://www.mcs.anl.gov/petsc/"

set     version                     3.25.0

depends-on phdf5
depends-on scalapack

prepend-path    PATH                /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/bin
prepend-path    INCLUDE             /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/include
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/lib

setenv          PETSC_DIR           /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0
setenv          PETSC_BIN           /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/bin
setenv          PETSC_INC           /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/include
setenv          PETSC_LIB           /opt/ohpc/pub/libs/gnu15/mpich/petsc/3.25.0/lib

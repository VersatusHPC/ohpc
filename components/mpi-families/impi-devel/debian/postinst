#!/bin/bash
set -e

# Make /opt/intel and /opt/ohpc writable for OBS build user
chmod -R a+w /opt/intel 2>/dev/null || true
chmod -R a+w /opt/ohpc 2>/dev/null || true

# Run module generator only if Intel MPI modulefiles-setup.sh exists
# (it's installed by arch:all packages which aren't in OBS DoD)
if [ -f /opt/intel/oneapi/modulefiles-setup.sh ]; then
    /opt/ohpc/admin/ohpc/bin/ohpc-update-modules-impi || true
fi

#DEBHELPER#

exit 0

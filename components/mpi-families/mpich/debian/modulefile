#%Module1.0#####################################################################

proc ModulesHelp { } {
puts stderr " "
puts stderr "This module loads the mpich library built with the gnu15 toolchain."
puts stderr "\nVersion 5.0.1\n"
}

module-whatis "Name: mpich built with gnu15 toolchain"
module-whatis "Version: 5.0.1"
module-whatis "Category: runtime library"
module-whatis "Description: MPICH MPI implementation"
module-whatis "URL: https://www.mpich.org"

set     version             5.0.1

setenv          MPI_DIR             /opt/ohpc/pub/mpi/mpich-ofi-gnu15-ohpc/5.0.1
prepend-path    PATH                /opt/ohpc/pub/mpi/mpich-ofi-gnu15-ohpc/5.0.1/bin
prepend-path    MANPATH             /opt/ohpc/pub/mpi/mpich-ofi-gnu15-ohpc/5.0.1/share/man
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/mpi/mpich-ofi-gnu15-ohpc/5.0.1/lib
prepend-path    MODULEPATH          /opt/ohpc/pub/moduledeps/gnu15-mpich
prepend-path    PKG_CONFIG_PATH     /opt/ohpc/pub/mpi/mpich-ofi-gnu15-ohpc/5.0.1/lib/pkgconfig

family "MPI"

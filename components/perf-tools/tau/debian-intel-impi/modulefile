#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the tau library built with the intel compiler"
puts stderr "toolchain and the impi MPI stack."
puts stderr "\nVersion 2.35.1\n"

}
module-whatis "Name: tau built with intel compiler and impi MPI"
module-whatis "Version: 2.35.1"
module-whatis "Category: performance tool"
module-whatis "Description: Tuning and Analysis Utilities profiling package"
module-whatis "URL: http://www.cs.uoregon.edu/research/tau/home.php"

set     version             2.35.1

prepend-path    PATH                /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/bin
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/lib
prepend-path    INCLUDE             /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/include

setenv          TAU_DIR             /opt/ohpc/pub/libs/intel/impi/tau/2.35.1
setenv          TAU_BIN             /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/bin
setenv          TAU_LIB             /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/lib
setenv          TAU_INC             /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/include
setenv          TAU_MAKEFILE        /opt/ohpc/pub/libs/intel/impi/tau/2.35.1/lib/Makefile.tau-mpi-pdt-openmp-papi

#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the pdtoolkit library built with the intel compiler"
puts stderr "toolchain."
puts stderr "\nVersion 3.25.1\n"

}
module-whatis "Name: pdtoolkit built with intel compiler"
module-whatis "Version: 3.25.1"
module-whatis "Category: performance tool"
module-whatis "Description: Program Database Toolkit"
module-whatis "URL: http://www.cs.uoregon.edu/Research/pdt"

set     version                     3.25.1

prepend-path    PATH                /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/bin
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/lib
prepend-path    INCLUDE             /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/include

setenv          PDTOOLKIT_DIR       /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1
setenv          PDTOOLKIT_BIN       /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/bin
setenv          PDTOOLKIT_LIB       /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/lib
setenv          PDTOOLKIT_INC       /opt/ohpc/pub/libs/intel/pdtoolkit/3.25.1/include

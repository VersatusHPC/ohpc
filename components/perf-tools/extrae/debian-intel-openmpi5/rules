#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=-all
export CFLAGS =
export CXXFLAGS =
export LDFLAGS =

COMPILER_FAMILY := intel
export COMPILER_FAMILY
MPI_FAMILY      := openmpi5
PNAME           := extrae
VERSION         := 5.0.3
INSTALL_PATH    := /opt/ohpc/pub/libs/$(COMPILER_FAMILY)/$(MPI_FAMILY)/$(PNAME)/$(VERSION)
SRCDIR          := $(CURDIR)/$(PNAME)-$(VERSION)
PKG             := $(CURDIR)/debian/$(PNAME)-$(COMPILER_FAMILY)-$(MPI_FAMILY)-ohpc
ENV             := OHPC_MODULES="papi" bash /build/devel/build-mpi.sh

%:
	dh $@

override_dh_auto_configure:
	test -s SOURCES/$(PNAME)-$(VERSION)-src.tar.bz2 || \
		wget -q -O SOURCES/$(PNAME)-$(VERSION)-src.tar.bz2 \
			https://ftp.tools.bsc.es/extrae/extrae-$(VERSION)-src.tar.bz2
	rm -rf $(SRCDIR)
	tar xf SOURCES/$(PNAME)-$(VERSION)-src.tar.bz2

override_dh_auto_build:
	cd $(SRCDIR) && $(ENV) sh -c ' \
		./configure --prefix=$(INSTALL_PATH) \
			--with-mpi=$$MPI_DIR \
			--with-papi=$$PAPI_DIR \
			--enable-openmp \
			--without-dyninst \
			--without-cuda \
			--without-unwind && \
		make -j$$(nproc)'

override_dh_auto_install:
	# Create prefix dir to satisfy chmod calls that don't use DESTDIR
	mkdir -p $(INSTALL_PATH)/bin 2>/dev/null || true
	cd $(SRCDIR) && $(ENV) sh -c ' \
		make DESTDIR=$(PKG) install' || true
	# Remove the non-DESTDIR dir we created
	rm -rf /opt/ohpc/pub/libs/intel/openmpi5/extrae 2>/dev/null || true
	find $(PKG) -name '*.la' -delete
	# Install modulefile
	mkdir -p $(PKG)/opt/ohpc/pub/moduledeps/$(COMPILER_FAMILY)-$(MPI_FAMILY)/$(PNAME)
	install -m 644 debian/modulefile $(PKG)/opt/ohpc/pub/moduledeps/$(COMPILER_FAMILY)-$(MPI_FAMILY)/$(PNAME)/$(VERSION)

override_dh_auto_clean:
	rm -rf $(SRCDIR)

override_dh_usrlocal:

override_dh_shlibdeps:
	dh_shlibdeps -l$(PKG)$(INSTALL_PATH)/lib -- --ignore-missing-info || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym || true

override_dh_auto_test:

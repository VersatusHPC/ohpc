#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=-all
export CFLAGS =
export CXXFLAGS =
export LDFLAGS =

PNAME        := valgrind
VERSION      := 3.26.0
INSTALL_PATH := /opt/ohpc/pub/utils/valgrind/$(VERSION)
SRCDIR       := $(CURDIR)/$(PNAME)-$(VERSION)
PKG          := $(CURDIR)/debian/$(PNAME)-ohpc

%:
	dh $@

override_dh_auto_configure:
	test -s SOURCES/$(PNAME)-$(VERSION).tar.bz2 || \
		wget -q -O SOURCES/$(PNAME)-$(VERSION).tar.bz2 \
			https://sourceware.org/pub/valgrind/valgrind-$(VERSION).tar.bz2
	rm -rf $(SRCDIR)
	tar xf SOURCES/$(PNAME)-$(VERSION).tar.bz2
	cd $(SRCDIR) && ./configure --prefix=$(INSTALL_PATH)

override_dh_auto_build:
	cd $(SRCDIR) && $(MAKE) -j$$(nproc)

override_dh_auto_install:
	cd $(SRCDIR) && $(MAKE) DESTDIR=$(PKG) install
	find $(PKG) -name '*.la' -delete
	# Install modulefile
	mkdir -p $(PKG)/opt/ohpc/pub/modulefiles/valgrind
	install -m 644 debian/modulefile $(PKG)/opt/ohpc/pub/modulefiles/valgrind/$(VERSION)

override_dh_auto_clean:
	rm -rf $(SRCDIR)

override_dh_usrlocal:

override_dh_shlibdeps:
	dh_shlibdeps -l$(PKG)$(INSTALL_PATH)/lib -- --ignore-missing-info || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym || true

override_dh_auto_test:

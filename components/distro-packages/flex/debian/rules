#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=-all
export CFLAGS =
export CXXFLAGS =
export LDFLAGS =

PNAME           := flex
VERSION         := 2.6.4
INSTALL_PATH    := /opt/ohpc/pub/libs/$(PNAME)/$(VERSION)
SRCDIR          := $(CURDIR)/$(PNAME)-$(VERSION)
PKG             := $(CURDIR)/debian/$(PNAME)-ohpc

%:
	dh $@

override_dh_auto_configure:
	test -s SOURCES/$(PNAME)-$(VERSION).tar.gz || \
		wget -q -O SOURCES/$(PNAME)-$(VERSION).tar.gz \
			https://github.com/westes/flex/releases/download/v$(VERSION)/$(PNAME)-$(VERSION).tar.gz
	rm -rf $(SRCDIR)
	tar xf SOURCES/$(PNAME)-$(VERSION).tar.gz

override_dh_auto_build:
	cd $(SRCDIR) && \
		./configure CFLAGS="-D_GNU_SOURCE" \
			--prefix=$(INSTALL_PATH) \
			--disable-shared && \
		make -j$$(nproc) MAKEINFO=true

override_dh_auto_install:
	cd $(SRCDIR) && make DESTDIR=$(PKG) install
	# Install modulefile
	mkdir -p $(PKG)/opt/ohpc/pub/modulefiles/$(PNAME)
	install -m 644 debian/modulefile $(PKG)/opt/ohpc/pub/modulefiles/$(PNAME)/$(VERSION)

override_dh_auto_clean:
	rm -rf $(SRCDIR)

override_dh_usrlocal:

override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym || true

override_dh_auto_test:

#!/bin/sh
set -e

if getent passwd slurm >/dev/null && getent group slurm >/dev/null; then
    install -d -m 0700 -o slurm -g slurm /var/log/slurm
    install -d -m 0700 -o slurm -g slurm /var/spool/slurmctld
    if [ ! -f /var/log/slurm_jobcomp.log ]; then
        touch /var/log/slurm_jobcomp.log
    fi
    chown slurm:slurm /var/log/slurm_jobcomp.log
fi

#DEBHELPER#

exit 0

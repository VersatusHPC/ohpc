#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the opari2 library built with the gnu15 compiler"
puts stderr "toolchain."
puts stderr "\nVersion 2.0.9\n"

}
module-whatis "Name: opari2 built with gnu15 compiler"
module-whatis "Version: 2.0.9"
module-whatis "Category: runtime library"
module-whatis "Description: An OpenMP runtime performance measurement instrumenter"
module-whatis "https://www.vi-hps.org/projects/score-p/"

set     version                     2.0.9

prepend-path    PATH                /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/bin
prepend-path    INCLUDE             /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/include
prepend-path    LD_LIBRARY_PATH     /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/lib
prepend-path    MANPATH             /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/share/man

setenv          OPARI2_DIR          /opt/ohpc/pub/libs/gnu15/opari2/2.0.9
setenv          OPARI2_BIN          /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/bin
setenv          OPARI2_LIB          /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/lib
setenv          OPARI2_INC          /opt/ohpc/pub/libs/gnu15/opari2/2.0.9/include

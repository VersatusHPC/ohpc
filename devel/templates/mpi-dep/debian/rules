#!/usr/bin/make -f
#
# OpenHPC compiler+MPI-dependent package template
# Replace @VARIABLES@ with actual values
#
# Build with: COMPILER_FAMILY=gnu15 MPI_FAMILY=openmpi5 dpkg-buildpackage ...

# Find OHPC_vars.mk relative to this package's location in the tree
OHPC_VARS_MK := $(shell for d in .. ../.. ../../.. ../../../.. ; do \
	[ -f "$$d/components/OHPC_vars.mk" ] && echo "$$d/components/OHPC_vars.mk" && break; \
done)
include $(OHPC_VARS_MK)

pname    := @PNAME@
version  := @VERSION@

INSTALL_PATH := $(call install_path_mpi,$(COMPILER_FAMILY),$(MPI_FAMILY),$(pname),$(version))
MODULE_PATH  := $(call module_path_mpi,$(COMPILER_FAMILY),$(MPI_FAMILY),$(pname))

%:
	dh $@

override_dh_auto_configure:
	$(OHPC_SETUP_COMPILER_MPI) && \
	./configure \
		--prefix=$(INSTALL_PATH) \
		--disable-static

override_dh_auto_build:
	$(OHPC_SETUP_COMPILER_MPI) && \
	$(MAKE)

override_dh_auto_install:
	$(OHPC_SETUP_COMPILER_MPI) && \
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp install
	# Remove .la files
	find debian/tmp -name '*.la' -delete
	# Install modulefile
	mkdir -p debian/tmp$(MODULE_PATH)
	install -m 644 debian/modulefile.lua debian/tmp$(MODULE_PATH)/$(version).lua

override_dh_usrlocal:
	# OpenHPC installs to /opt/ohpc

override_dh_shlibdeps:
	dh_shlibdeps -l$(INSTALL_PATH)/lib -- --ignore-missing-info || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym || true
